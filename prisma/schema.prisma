// Prisma schema for RatoneraMarketing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String?       @db.VarChar(255)
  phoneE164            String        @unique @map("phone_e164") @db.VarChar(20)
  source               String?       @db.VarChar(50)
  attended             Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  
  // New fields from migration 001
  optedIn              Boolean       @default(false) @map("opted_in")
  optInSource          OptInSource?  @map("opt_in_source")
  optInDate            DateTime?     @map("opt_in_date") @db.Timestamptz(6)
  optOutReason         OptOutReason? @map("opt_out_reason")
  optOutDate           DateTime?     @map("opt_out_date") @db.Timestamptz(6)
  lastMessageAt        DateTime?     @map("last_message_at") @db.Timestamptz(6)
  lastReplyAt          DateTime?     @map("last_reply_at") @db.Timestamptz(6)
  lastDeliveryStatus   DeliveryStatus? @map("last_delivery_status")
  lastTemplateName     String?       @map("last_template_name") @db.Text
  engagementScore      Int?          @map("engagement_score")
  doNotContact         Boolean       @default(false) @map("do_not_contact")
  
  contactShows         ContactShow[]

  @@map("contacts")
}

model Show {
  id           Int           @id @default(autoincrement())
  slug         String        @unique @db.VarChar(10)
  showDate     DateTime      @map("show_date") @db.Date
  venue        String        @db.VarChar(50)
  
  contactShows ContactShow[]

  @@map("shows")
}

model ContactShow {
  id         Int     @id @default(autoincrement())
  contactId  String  @map("contact_id") @db.Uuid
  showId     Int     @map("show_id")
  
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  show       Show    @relation(fields: [showId], references: [id])
  
  @@unique([contactId, showId])
  @@map("contact_shows")
}

enum OptInSource {
  reoptin_campaign
  inbound_whatsapp
  form
  ads
  manual

  @@map("opt_in_source_enum")
}

enum OptOutReason {
  user_no
  no_response_cleanup
  bounce
  unknown

  @@map("opt_out_reason_enum")
}

enum DeliveryStatus {
  sent
  delivered
  read
  failed
  unknown

  @@map("delivery_status_enum")
}
